generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id           String        @id @default(uuid())
  name         String
  description  String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  customFields CustomField[]
  histories    History[]
  laptops      Laptop[]
  licenses     License[]
  pcs          PC[]
  printers     Printer[]
  users        User[]
  warehouseITs WarehouseIT[]

  @@index([id])
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  password  String
  name      String
  role      String    @default("user")
  tenantId  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  histories History[]
  laptops   Laptop[]
  pcs       PC[]
  tenant    Tenant    @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

model PC {
  id                String    @id @default(uuid())
  dept              String
  cpuBarcode        String    @unique
  cpuSapBarcode     String?
  monitorBarcode    String?
  monitorSapBarcode String?
  upsBarcode        String?
  upsSapBarcode     String?
  pcName            String
  userId            String?
  status            String    @default("active")
  note              String?
  tenantId          String
  customFields      Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  tenant            Tenant    @relation(fields: [tenantId], references: [id])
  user              User?     @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([userId])
}

model Laptop {
  id           String    @id @default(uuid())
  dept         String
  barcode      String    @unique
  sapBarcode   String?
  dateBuy      DateTime?
  userId       String?
  email        String?
  model        String?
  status       String    @default("active")
  tenantId     String
  customFields Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  tenant       Tenant    @relation(fields: [tenantId], references: [id])
  user         User?     @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([userId])
}

model Printer {
  id           String    @id @default(uuid())
  dept         String
  location     String?
  ip           String?
  model        String?
  color        Boolean   @default(false)
  barcode      String    @unique
  sapCode      String?
  date         DateTime?
  note         String?
  tenantId     String
  customFields Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  tenant       Tenant    @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

model License {
  id           String    @id @default(uuid())
  deviceName   String?
  userName     String?
  dept         String?
  productType  String?
  productKey   String?
  model        String?
  pc           String?
  mac          String?
  ip           String?
  date         DateTime?
  updateStatus String?   @default("active")
  tenantId     String
  customFields Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  tenant       Tenant    @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

model WarehouseIT {
  id                String    @id @default(uuid())
  cpuBarcode        String?
  cpuSapBarcode     String?
  monitorBarcode    String?
  monitorSapBarcode String?
  upsBarcode        String?
  upsSapBarcode     String?
  status            String    @default("available")
  note              String?
  tenantId          String
  customFields      Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  tenant            Tenant    @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

model CustomField {
  id        String   @id @default(uuid())
  name      String
  type      String
  modelType String
  tenantId  String
  required  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([modelType])
}

model History {
  id        String      @id @default(uuid())
  action    String
  modelType String
  recordId  String
  changes   Json
  userId    String?
  tenantId  String
  createdAt DateTime    @default(now())
  tenant    Tenant      @relation(fields: [tenantId], references: [id])
  user      User?       @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([userId])
  @@index([modelType, recordId])
}
