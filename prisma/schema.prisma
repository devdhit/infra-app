generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                 String             @id @default(uuid())
  name               String
  description        String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  customFields       CustomField[]
  histories          History[]
  laptops            Laptop[]
  licenses           License[]
  pcs                PC[]
  printers           Printer[]
  users              User[]
  warehouseITs       WarehouseIT[]
  internets          Internet[]
  auditLogsSettings  AuditLogsSettings?
  roles              Role[]

  @@index([id])
}

model Role {
  id          String   @id @default(uuid())
  name        String
  description String?
  permissions Json     @default("{}")
  tenantId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  users       User[]

  @@index([tenantId])
  @@unique([name, tenantId])
}

model User {
  id                   String    @id @default(uuid())
  email                String    @unique
  password             String
  name                 String
  roleId               String?
  tenantId             String
  failedLoginAttempts  Int       @default(0)
  lockedAt             DateTime?
  lockedUntil          DateTime?
  lastLoginAttempt     DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  histories            History[]
  tenant               Tenant    @relation(fields: [tenantId], references: [id])
  role                 Role?     @relation(fields: [roleId], references: [id])

  @@index([tenantId])
  @@index([roleId])
}

model PC {
  id                String    @id @default(uuid())
  dept              String
  cpuBarcode        String?
  cpuSapBarcode     String?
  monitorBarcode    String?
  monitorSapBarcode String?
  upsBarcode        String?
  upsSapBarcode     String?
  pcName            String
  userName          String?
  status            String    @default("working")
  note              String?
  tenantId          String
  customFields      Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  tenant            Tenant    @relation(fields: [tenantId], references: [id])
  search_vector     Unsupported("tsvector")?

  @@index([tenantId])
  @@index([status])
  @@index([userName])
  @@index([dept])
  @@index([createdAt])
  @@index([search_vector], type: Gin)
}

model Laptop {
  id           String    @id @default(uuid())
  dept         String
  barcode      String
  sapBarcode   String?
  dateBuy      DateTime?
  userName     String?
  email        String?
  model        String?
  status       String    @default("working")
  tenantId     String
  customFields Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  tenant       Tenant    @relation(fields: [tenantId], references: [id])
  search_vector Unsupported("tsvector")?

  @@index([tenantId])
  @@index([status])
  @@index([userName])
  @@index([dept])
  @@index([createdAt])
  @@index([dateBuy])
  @@index([search_vector], type: Gin)
}

model Printer {
  id           String    @id @default(uuid())
  dept         String
  location     String?
  ip           String?
  model        String?
  color        String    @default("Black & White")
  barcode      String?
  sapCode      String?
  date         DateTime?
  note         String?
  tenantId     String
  customFields Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  tenant       Tenant    @relation(fields: [tenantId], references: [id])
  search_vector Unsupported("tsvector")?

  @@index([tenantId])
  @@index([dept])
  @@index([createdAt])
  @@index([barcode])
  @@index([search_vector], type: Gin)
}

model License {
  id           String    @id @default(uuid())
  deviceName   String?
  userName     String?
  dept         String?
  productType  String?
  productKey   String?
  model        String?
  pc           String?
  mac          String?
  ip           String?
  date         DateTime?
  updateStatus String?   @default("working")
  tenantId     String
  customFields Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  tenant       Tenant    @relation(fields: [tenantId], references: [id])
  search_vector Unsupported("tsvector")?

  @@index([tenantId])
  @@index([updateStatus])
  @@index([userName])
  @@index([dept])
  @@index([createdAt])
  @@index([productType])
  @@index([search_vector], type: Gin)
}

model WarehouseIT {
  id           String    @id @default(uuid())
  barcode      String?
  sapCode      String?
  status       String    @default("working")
  note         String?
  tenantId     String
  customFields Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  tenant       Tenant    @relation(fields: [tenantId], references: [id])
  search_vector Unsupported("tsvector")?

  @@index([tenantId])
  @@index([status])
  @@index([createdAt])
  @@index([search_vector], type: Gin)
}

model Internet {
  id             String    @id @default(uuid())
  dept           String
  manager        String?
  userName       String?
  email          String?
  ipAddress      String?
  internetAccess String?
  status         String    @default("working")
  note           String?
  tenantId       String
  customFields   Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  tenant         Tenant    @relation(fields: [tenantId], references: [id])
  search_vector  Unsupported("tsvector")?

  @@index([tenantId])
  @@index([status])
  @@index([userName])
  @@index([dept])
  @@index([email])
  @@index([ipAddress])
  @@index([createdAt])
  @@index([search_vector], type: Gin)
}

model CustomField {
  id          String   @id @default(uuid())
  name        String
  type        String
  modelType   String
  description String?
  tenantId    String
  required    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([modelType])
}

model History {
  id        String      @id @default(uuid())
  action    String
  modelType String
  recordId  String
  changes   Json
  userId    String?
  tenantId  String
  createdAt DateTime    @default(now())
  tenant    Tenant      @relation(fields: [tenantId], references: [id])
  user      User?       @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([userId])
  @@index([modelType, recordId])
}

model AuditLogsSettings {
  id                    String   @id @default(uuid())
  tenantId              String   @unique
  enabled               Boolean  @default(true)
  retentionPeriod       Int      @default(90)
  logAssetCreation      Boolean  @default(true)
  logAssetUpdates       Boolean  @default(true)
  logAssetDeletion      Boolean  @default(true)
  logUserLogin          Boolean  @default(true)
  logUserLogout         Boolean  @default(true)
  logPermissionChanges  Boolean  @default(true)
  notifyOnCriticalEvents Boolean @default(true)
  emailNotifications    Boolean  @default(true)
  slackNotifications    Boolean  @default(false)
  notificationEmail     String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  tenant                Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}